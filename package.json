{
  "name": "react-graft",
  "version": "0.3.0",
  "description": "A factory that turns a hook into a React context, with a set of small state hooks to put in it.",
  "keywords": [
    "react",
    "hooks",
    "context",
    "provider",
    "state",
    "typescript"
  ],
  "license": "MIT",
  "author": "Roberto Attanasio",
  "homepage": "https://dev.robertoattanasio.com/react-graft",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertoattanasio/react-graft.git"
  },
  "bugs": {
    "url": "https://github.com/robertoattanasio/react-graft/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "workspaces": [
    "."
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "ts:check": "tsc --noEmit",
    "build": "rm -rf dist && tsc",
    "changeset:add": "changeset",
    "changeset:bump": "changeset version",
    "build:release": "npm run ts:check && npm run build && npm pack && changeset publish && git push --follow-tags"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1"
  }
}
