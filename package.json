{
  "name": "react-graft",
  "version": "2.0.0",
  "description": "Turns a hook into a typed React context where each component re-renders only on the fields it reads, with side effects that belong to the provider.",
  "keywords": [
    "react",
    "hooks",
    "context",
    "provider",
    "side-effects",
    "typescript",
    "state",
    "re-render",
    "proxy"
  ],
  "license": "MIT",
  "author": "Roberto Attanasio",
  "homepage": "https://react-graft.robertoattanasio.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertoattanasio/react-graft.git"
  },
  "bugs": {
    "url": "https://github.com/robertoattanasio/react-graft/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "workspaces": [
    "."
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "default": "./dist/hooks/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "ts:check": "tsc --noEmit",
    "dev": "tsc --watch --preserveWatchOutput",
    "build": "rm -rf dist && tsc",
    "changeset:add": "changeset",
    "changeset:bump": "changeset version",
    "build:release": "npm run ts:check && npm run build && npm pack && changeset publish && git push --follow-tags"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/react": "^19.2.14",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "proxy-compare": "^3.0.1"
  }
}
